# =========================================================
# GN SCALES — APACHE CONFIGURATION (cPanel)
#
# Only Apache reads this; GitHub Pages ignores it. The site is static, so
# this is just: one canonical https origin, a real 404, compression, cache
# headers, security headers, and nothing private served.
# =========================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- One canonical origin: https://gnscales.com ----------------------
  # Only for the real domain, so cPanel's temporary URL and previews still
  # load. If the certificate does not cover www yet, fix that first — the
  # browser hits the TLS error before it ever sees this redirect.
  RewriteCond %{HTTP_HOST} ^(www\.)?gnscales\.com$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://gnscales.com/$1 [R=301,L]
</IfModule>

# --- Custom error pages ----------------------------------------------
# Stale Shopify URLs still in Google's index land here rather than on a
# bare Apache error page.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# --- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Caching -------------------------------------------------------------
# CSS and JS are cache-busted by hand with ?v= (see docs/README.md), so
# they get a week rather than "immutable": a forgotten ?v= bump heals
# itself instead of sticking for a year. HTML is always revalidated, so an
# edit is live on the next page load.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|json|webmanifest|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Security headers ----------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Fonts are same-origin, but the preload in <head> requests them with
  # crossorigin, so they need this to be usable.
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# --- Nothing here is meant to be served -----------------------------------
# data/ is left over from the old PHP admin and still holds past enquiries.
# The deploy never touches it; this keeps it unreachable.
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)^/data(/|$)
RedirectMatch 404 (?i)^/(docs|tools)(/|$)
RedirectMatch 404 (?i)\.(yml|yaml|md|log|bak|sql|ini|sh|py)$

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
